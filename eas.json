{
    "cli": {
        "version": ">= 13.2.1",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "gradleCommand": ":app:assembleDebug",
                "buildType": "apk"
            },
            "ios": {
                "buildConfiguration": "Debug"
            },
            "env": {
                "EXPO_PUBLIC_API_URL": "http://192.168.0.109:5000"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            },
            "env": {
                "EXPO_PUBLIC_API_URL": "http://192.168.0.109:5000"
            }
        },
        "staging": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            },
            "env": {
                "EXPO_PUBLIC_API_URL": "https://ai-powered-mobile-chat-application.onrender.com"
            }
        },
        "production": {
            "autoIncrement": true,
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "EXPO_PUBLIC_API_URL": "https://ai-powered-mobile-chat-application.onrender.com"
            }
        },
        "production-apk": {
            "extends": "production",
            "android": {
                "buildType": "apk"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "serviceAccountKeyPath": "./android-service-account.json",
                "track": "internal"
            },
            "ios": {
                "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
                "appleId": "YOUR_APPLE_ID",
                "appleTeamId": "YOUR_APPLE_TEAM_ID"
            }
        }
    }
}
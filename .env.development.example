# Development Environment Variables
# Copy this file to .env.development and update with your local setup

# Your local machine IP address (update this with your actual IP)
# Find your IP:
# - Windows: Run `ipconfig` and look for IPv4 Address
# - Mac/Linux: Run `ifconfig` or `ip addr`
EXPO_PUBLIC_API_URL=http://192.168.0.108:5000

# Environment identifier
EXPO_PUBLIC_ENVIRONMENT=development
